[runtime]
device_id = "replace-with-device-id"
server_url = "wss://example.com/api/v1/robot/ws/replace-with-device-id"
device_token = "replace-with-device-token"
language = "zh"
voice_id = "replace-with-minimax-voice-id"
tts_model = "speech-2.8-turbo"

[audio]
codec = "wav"
sample_rate_hz = 16000
channels = 1
duration_seconds = 4.0
# ALSA device name, for example "plughw:1,0". Leave unset to use the default device.
# device = "plughw:1,0"

[listen]
probe_duration_seconds = 0.75
voice_threshold = 0.02
idle_sleep_seconds = 0.2
cooldown_seconds = 0.75
session_id_prefix = "listen"

[updates]
channel = "stable"
manifest_url = "https://updates.example.com/manifest.json"
check_interval_minutes = 30
